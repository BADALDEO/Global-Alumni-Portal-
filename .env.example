# Copy this file to ".env" (same folder as manage.py). It is read automatically and never committed.

# ---- Google sign-in (see README for how to get these) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Only for deployment (leave these out while developing) ----
# DEBUG=False
# SECRET_KEY=put-a-long-random-string-here
# ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# DATABASE_URL=postgres://user:password@host:5432/dbname
# MEDIA_ROOT=/var/data/media
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
